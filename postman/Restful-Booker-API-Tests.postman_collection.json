        {
          "name": "TC-S02-06 Verify a partial update changes only the fields sent",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Start from what the booking currently looks like.\r",
                  "const current = JSON.parse(pm.collectionVariables.get(\"expectedBooking\"));\r",
                  "\r",
                  "// Change ONLY the names.\r",
                  "const patch = {\r",
                  "    firstname: pm.variables.replaceIn(\"{{$randomFirstName}}\"),\r",
                  "    lastname: pm.variables.replaceIn(\"{{$randomLastName}}\") + \"-\" + Date.now()\r",
                  "};\r",
                  "\r",
                  "// Send just the two changed fields...\r",
                  "pm.collectionVariables.set(\"patchBody\", JSON.stringify(patch));\r",
                  "\r",
                  "// ...but expect the WHOLE booking back, with only those two fields different.\r",
                  "// { ...current, ...patch } copies current, then overwrites the names.\r",
                  "pm.collectionVariables.set(\"expectedBooking\", JSON.stringify({ ...current, ...patch }));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// A partial update by an authorized user should succeed.\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Names changed, everything else untouched (R4, R8).\r",
                  "pm.test(\"Only the patched fields changed\", () => {\r",
                  "    const expected = JSON.parse(pm.collectionVariables.get(\"expectedBooking\"));\r",
                  "    pm.expect(pm.response.json()).to.eql(expected);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
