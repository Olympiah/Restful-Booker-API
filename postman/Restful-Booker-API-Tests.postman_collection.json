        {
          "name": "TC-S02-04 Verify a full update replaces all booking fields",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Build a completely new version of the booking.\r",
                  "// Every field changes, so we can prove PUT replaces the whole record.\r",
                  "const updated = {\r",
                  "    firstname: pm.variables.replaceIn(\"{{$randomFirstName}}\"),\r",
                  "    lastname: pm.variables.replaceIn(\"{{$randomLastName}}\") + \"-\" + Date.now(),\r",
                  "    totalprice: 275,\r",
                  "    depositpaid: false,\r",
                  "    bookingdates: {\r",
                  "        checkin: \"2026-12-10\",\r",
                  "        checkout: \"2026-12-15\"\r",
                  "    },\r",
                  "    additionalneeds: \"Late checkout\"\r",
                  "};\r",
                  "\r",
                  "// This is now what the booking SHOULD look like.\r",
                  "// The body sends it, and later requests compare against it.\r",
                  "pm.collectionVariables.set(\"expectedBooking\", JSON.stringify(updated));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// A full update by an authorized user should succeed.\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// The response must show every new value (R4, R8).\r",
                  "pm.test(\"Response shows all the new values\", () => {\r",
                  "    const expected = JSON.parse(pm.collectionVariables.get(\"expectedBooking\"));\r",
                  "    pm.expect(pm.response.json()).to.eql(expected);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
