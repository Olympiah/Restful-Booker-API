    {
      "name": "02 Booking Lifecycle",
      "item": [
        {
          "name": "TC-S02-01 Verify a booking is created with valid data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const booking = {\r",
                  "    firstname: pm.variables.replaceIn(\"{{$randomFirstName}}\"),\r",
                  "    lastname: pm.variables.replaceIn(\"{{$randomLastName}}\") + \"-\" + Date.now(),\r",
                  "    totalprice: 150,\r",
                  "    depositpaid: true,\r",
                  "    bookingdates: {\r",
                  "        checkin: \"2026-11-01\",\r",
                  "        checkout: \"2026-11-05\"\r",
                  "    },\r",
                  "    additionalneeds: \"Breakfast\"\r",
                  "};\r",
                  "\r",
                  "pm.collectionVariables.set(\"expectedBooking\", JSON.stringify(booking));"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Create should succeed. Restful-Booker documents 200 for create.\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Read the response safely: if it isn't JSON, use an empty object\r",
                  "// so the tests below fail cleanly instead of crashing the script.\r",
                  "let body = {};\r",
                  "try {\r",
                  "    body = pm.response.json();\r",
                  "} catch (e) {\r",
                  "    console.log(\"Response was not JSON:\", pm.response.text());\r",
                  "}\r",
                  "\r",
                  "// The API must return the new booking's ID as a number.\r",
                  "pm.test(\"Response has a numeric bookingid\", () => {\r",
                  "    pm.expect(body.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "// Save the ID OUTSIDE the test block so Postman keeps it,\r",
                  "// and only when it's valid, so a bad response can't overwrite a good ID.\r",
                  "if (typeof body.bookingid === \"number\") {\r",
                  "    // pm.collectionVariables.set(\"bookingid\", String(body.bookingid));\r",
                  "    pm.environment.set(\"bookingid\", String(body.bookingid));\r",
                  "    console.log(\"Saved bookingid:\", body.bookingid);\r",
                  "}\r",
                  "\r",
                  "// The stored booking must match exactly what we sent (R4: data integrity).\r",
                  "// to.eql does a deep comparison, so nested dates are checked too.\r",
                  "pm.test(\"Booking matches the data sent\", () => {\r",
                  "    const expected = JSON.parse(pm.collectionVariables.get(\"expectedBooking\"));\r",
                  "    pm.expect(body.booking).to.eql(expected);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{expectedBooking}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-S02-02 Verify the new booking appears in the booking ID list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Listing bookings should succeed.\r",
                  "pm.test(\"Status is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// The list is an array of { bookingid } objects.\r",
                  "// Pull out just the IDs and check ours is among them.\r",
                  "// Number() converts the saved ID back from text to a number.\r",
                  "pm.test(\"List contains the new booking\", () => {\r",
                  "    // const targetId = Number(pm.collectionVariables.get(\"bookingid\"));\r",
                  "    const targetId = Number(pm.environment.get(\"bookingid\"));\r",
                  "    const ids = pm.response.json().map(b => b.bookingid);\r",
                  "    pm.expect(ids, `Booking ID ${targetId} was not found in the list`).to.include(targetId);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
